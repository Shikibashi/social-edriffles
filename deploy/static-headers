/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' https://api.bsky.app https://public.api.bsky.app https://bsky.social https://*.bsky.network https://*.bsky.app https://*.bsky.social; frame-src 'self' https:; media-src 'self' blob: https:; worker-src 'self' blob:

/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/manifest.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
